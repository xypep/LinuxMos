-- LinuxMos: macOS-artiges System-Widget (Glass-Look)
-- Template: Die Platzhalter (Farben, Wetter) ersetzt install.sh.
-- Leichtgewichtig: Update alle 3 s, Wetter nur alle 30 min, keine Lua/Cairo-Zeichnungen.

conky.config = {
    update_interval = 3,
    total_run_times = 0,
    cpu_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,

    own_window = true,
    own_window_type = 'normal',
    own_window_class = 'Conky',
    own_window_title = 'linuxmos-stats',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value = 150,
    own_window_colour = '@BG@',

    alignment = 'top_right',
    gap_x = 24,
    gap_y = 52,
    minimum_width = 220,
    maximum_width = 220,
    border_inner_margin = 16,

    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    draw_graph_borders = false,
    default_bar_width = 220,
    default_bar_height = 5,

    use_xft = true,
    font = 'Inter:size=10',
    default_color = '@FG@',
    color1 = '@FG2@',
    color2 = '@ACCENT@',
    override_utf8_locale = true,
}

conky.text = [[
${color1}${font Inter:style=Bold:size=9}SYSTEM${font}${color}
${voffset 4}CPU${alignr}${cpu cpu0} %
${color2}${cpubar cpu0}${color}
RAM${alignr}${mem} / ${memmax}
${color2}${membar}${color}
Disk /${alignr}${fs_used /} / ${fs_size /}
${color2}${fs_bar /}${color}
${if_existing /sys/class/power_supply/BAT0}Akku${alignr}${battery_percent BAT0} %
${color2}${battery_bar BAT0}${color}
${endif}${color1}Uptime${alignr}${uptime_short}${color}@WEATHER@
]]
