#!/usr/bin/env bash
# MosIsland (LinuxMos) – starten und steuern.
#
#   linuxmos-island                 starten (läuft sie schon: auf-/zuklappen)
#   linuxmos-island --toggle        auf-/zuklappen
#   linuxmos-island --tab NAME      Tab öffnen: search|home|clipboard|shelf|todo|note|water|stretch|weather|controls
#                                   (search = Command Bar: Apps, Dateien, Rechner, Einheiten, Web)
#   linuxmos-island --shot MODE     Screenshot: area (Bereich) | screen (Monitor unter der Maus)
#   linuxmos-island --ocr           Text aus einem Bereich erkennen -> Zwischenablage
#   linuxmos-island --qr            QR-Code/Barcode aus einem Bereich lesen -> Zwischenablage
#   linuxmos-island --record MODE  Bildschirmaufnahme: area (Bereich) | screen (Monitor unter der Maus);
#                                   nochmal aufrufen beendet und speichert sie (MP4 oder GIF)
#   linuxmos-island --chat         KI-Chat öffnen (Tab, braucht "ai_chat": true)
#   linuxmos-island --voice        Diktat: Aufnahme starten, nochmal aufrufen = Text erkennen
#   linuxmos-island --set-key      API-Key für den KI-Chat im Schlüsselbund speichern
#   linuxmos-island --clip-send    Zwischenablage an den Standard-Peer senden (Clip-Transfer, nur auf Aufruf)
#   linuxmos-island --settings [--tab overview|gestures|functions]
#                                  Einstellungen & Übersicht (eigenes Fenster, nur solange es offen ist)
#   linuxmos-island --action ID    eine Funktion aus dem Register auslösen (Liste: --list-actions)
#   linuxmos-island --list-actions Alle Funktionen als Tabelle (--markdown: Hotkey-Tabelle fürs README)
#   linuxmos-island --check-hotkeys Hotkeys auf Konflikte prüfen (untereinander und mit Cinnamon)
#   linuxmos-island --stretch-now  sofort eine Dehn-Karte zeigen (zum Ausprobieren)
#   linuxmos-island --stretch-test starten mit 1 Minute Intervall und Leerlauf-Schwellen in Sekunden
#   linuxmos-island --force-idle   starten im Leerlauf: Maskottchen bzw. Augen-Modus ohne Warten
#                                  (Hover oder Klick beendet es). Die beiden letzten gehen nur beim Start.
#   linuxmos-island --quit          beenden
#   linuxmos-island --set-city ORT  Wetter-Ort festlegen
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../island/__init__.py" ]]; then
  APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"        # aus dem Repo heraus
else
  APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/linuxmos/island-app"
fi
# System-Python: nur dort liegt PyGObject (python3-gi), nicht in pyenv/conda
PYTHON="${LINUXMOS_PYTHON:-/usr/bin/python3}"

# Hotkeys sprechen die laufende Insel direkt über D-Bus an (~10 ms statt Python-Start)
action() {
  gdbus call --session --dest org.linuxmos.Island --object-path /org/linuxmos/Island \
    --method org.gtk.Actions.Activate "$1" "$2" "{}" >/dev/null 2>&1
}

case "${1:-}" in
  --toggle)
    action toggle "[]" && exit 0 ;;
  --tab)
    [[ "${2:-}" =~ ^[a-z]+$ ]] || { echo "Usage: $(basename "$0") --tab search|home|clipboard|shelf|todo|note|water|stretch|weather|controls" >&2; exit 2; }
    action tab "[<'$2'>]" && exit 0 ;;
  --shot)
    [[ "${2:-}" =~ ^(area|screen)$ ]] || { echo "Usage: $(basename "$0") --shot area|screen" >&2; exit 2; }
    action screenshot "[<'$2'>]" && exit 0
    # Insel läuft nicht: kurzlebiger Prozess nur für den Screenshot
    cd /
    PYTHONPATH="${APP_DIR}" exec "${PYTHON}" -m island.shot "$2" ;;
  --ocr|--qr)
    action "${1#--}" "[]" && exit 0
    cd /
    PYTHONPATH="${APP_DIR}" exec "${PYTHON}" -m island.shot "${1#--}" ;;
  --record)
    [[ "${2:-}" =~ ^(area|screen)$ ]] || { echo "Usage: $(basename "$0") --record area|screen" >&2; exit 2; }
    action record "[<'$2'>]" && exit 0
    echo "MosIsland läuft nicht – Aufnahmen gehen nur mit laufender Insel." >&2
    exit 1 ;;
  --chat)
    action chat "[]" && exit 0
    echo "MosIsland läuft nicht." >&2
    exit 1 ;;
  --voice)
    action voice "[]" && exit 0
    echo "MosIsland läuft nicht – Diktat geht nur mit laufender Insel." >&2
    exit 1 ;;
  --clip-send)
    action clip-send "[]" && exit 0
    echo "MosIsland läuft nicht – Clip-Senden geht nur mit laufender Insel (oder: linuxmos-clip send)." >&2
    exit 1 ;;
  --settings)
    # Eigener Prozess: braucht die Insel nicht (läuft sie nicht, zeigt das Fenster nur die Config)
    shift
    cd /
    PYTHONPATH="${APP_DIR}" exec "${PYTHON}" -m island.settings "$@" ;;
  --action)
    [[ "${2:-}" =~ ^[a-z0-9-]+$ ]] || { echo "Usage: $(basename "$0") --action ID   (IDs: $(basename "$0") --list-actions)" >&2; exit 2; }
    action run "[<'$2'>]" && exit 0
    echo "MosIsland läuft nicht – Funktionen gehen nur mit laufender Insel (Liste: $(basename "$0") --list-actions)." >&2
    exit 1 ;;
  --stretch-now)
    action stretch-now "[]" && exit 0 ;;   # läuft sie nicht, startet die Insel damit und zeigt die Karte
  --quit)
    action quit "[]" || true
    exit 0 ;;
esac

# Noch nicht gestartet (oder --set-city/--version): Python-App starten
cd /
PYTHONPATH="${APP_DIR}" exec "${PYTHON}" -m island "$@"
