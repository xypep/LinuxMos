#!/usr/bin/env bash
# MosIsland (LinuxMos) – starten und steuern.
#
#   linuxmos-island                 starten (läuft sie schon: auf-/zuklappen)
#   linuxmos-island --toggle        auf-/zuklappen
#   linuxmos-island --tab NAME      Tab öffnen: home|clipboard|shelf|note|weather|controls
#   linuxmos-island --quit          beenden
#   linuxmos-island --set-city ORT  Wetter-Ort festlegen
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../island/__init__.py" ]]; then
  APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"        # aus dem Repo heraus
else
  APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/linuxmos/island-app"
fi
# System-Python: nur dort liegt PyGObject (python3-gi), nicht in pyenv/conda
PYTHON="${LINUXMOS_PYTHON:-/usr/bin/python3}"

# Hotkeys sprechen die laufende Insel direkt über D-Bus an (~10 ms statt Python-Start)
action() {
  gdbus call --session --dest org.linuxmos.Island --object-path /org/linuxmos/Island \
    --method org.gtk.Actions.Activate "$1" "$2" "{}" >/dev/null 2>&1
}

case "${1:-}" in
  --toggle)
    action toggle "[]" && exit 0 ;;
  --tab)
    [[ "${2:-}" =~ ^[a-z]+$ ]] || { echo "Usage: $(basename "$0") --tab home|clipboard|shelf|note|weather|controls" >&2; exit 2; }
    action tab "[<'$2'>]" && exit 0 ;;
  --quit)
    action quit "[]" || true
    exit 0 ;;
esac

# Noch nicht gestartet (oder --set-city/--version): Python-App starten
cd /
PYTHONPATH="${APP_DIR}" exec "${PYTHON}" -m island "$@"
