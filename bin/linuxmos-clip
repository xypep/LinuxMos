#!/usr/bin/env python3
# linuxmos-clip – Clips (Text, Bilder, Dateien) per SSH zwischen PCs. Siehe docs/CLIP.md.
#
#   linuxmos-clip setup | doctor | send | receive | receive-ssh | apply | list | clean | --selftest
#
# Reines Python ohne GTK: läuft auch auf einem Rechner ohne Bildschirm (Empfang per sshd).
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
repo = os.path.dirname(here)
if os.path.isfile(os.path.join(repo, "island", "__init__.py")):
    app_dir = repo                                       # aus dem Repo heraus
else:
    app_dir = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                           "linuxmos", "island-app")
sys.path.insert(0, app_dir)

from island.clipcli import main  # noqa: E402

sys.exit(main())
